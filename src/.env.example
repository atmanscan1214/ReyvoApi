# ---------------------------------------------------------------------------
# Reyvo API - example environment
# Copy to .env and replace every placeholder before running in production.
# ---------------------------------------------------------------------------

APP_NAME=Reyvo API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
APP_PUBLIC_URL=http://localhost:3000

# Auth
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# Encryption for OAuth tokens (Fernet key, base64). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Database
# Production: postgresql+psycopg://reyvo:reyvo@localhost:5432/reyvo
DATABASE_URL=postgresql+psycopg://reyvo:reyvo@localhost:5432/reyvo
AUTO_CREATE_TABLES=false

# Redis / queue (reserved for the send worker and rate limits)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Google Workspace / Gmail OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email-accounts/oauth/google/callback

# ---------------------------------------------------------------------------
# Microsoft 365 / Graph OAuth
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/email-accounts/oauth/microsoft/callback

# ---------------------------------------------------------------------------
# WorkOS enterprise SSO (optional; local password login always stays enabled)
# ---------------------------------------------------------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
WORKOS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI drafting (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ---------------------------------------------------------------------------
# Sending safety defaults
# ---------------------------------------------------------------------------
DEFAULT_DAILY_CAP=50
DEFAULT_HOURLY_CAP=25
REQUIRE_EMAIL_ACCOUNT_FOR_LAUNCH=true
