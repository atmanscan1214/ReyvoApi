# ---------------------------------------------------------------------------
# Reyvo API - example environment
# Copy to .env and replace every placeholder before running in production.
# ---------------------------------------------------------------------------

APP_NAME=Reyvo API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
APP_PUBLIC_URL=http://localhost:3000

# Auth
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# Encryption for OAuth tokens (Fernet key, base64). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Database
# Production: postgresql+psycopg://reyvo:reyvo@localhost:5432/reyvo
DATABASE_URL=postgresql+psycopg://reyvo:reyvo@localhost:5432/reyvo
AUTO_CREATE_TABLES=false

# Redis / queue (shared rate limits and Arq background jobs)
# Leave REDIS_URL blank to keep rate limiting in-process and disable jobs.
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2
BACKGROUND_JOBS_ENABLED=true

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Google Workspace / Gmail OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email-accounts/oauth/google/callback

# ---------------------------------------------------------------------------
# Microsoft 365 / Graph OAuth
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/email-accounts/oauth/microsoft/callback

# ---------------------------------------------------------------------------
# WorkOS enterprise SSO (optional; local password login always stays enabled)
# ---------------------------------------------------------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
WORKOS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI drafting and knowledge-base chat (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional embeddings power semantic retrieval; leave blank for lexical-only search.
AI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Knowledge base (design document ingestion)
# ---------------------------------------------------------------------------
DESIGN_DOC_PATH=Reyvo_Detailed_Design_Document_v1.0.docx
KNOWLEDGE_TOP_K=6
# platform_admin (default) keeps the internal design corpus private; set to
# "members" only after curating a customer-facing document.
KNOWLEDGE_CHAT_ACCESS=platform_admin
# Per-user chat/search limit per minute (shared through Redis when configured).
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
# Delete chat conversations with no activity for this many days (0 keeps them).
CHAT_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ---------------------------------------------------------------------------
# Sending safety defaults
# ---------------------------------------------------------------------------
DEFAULT_DAILY_CAP=50
DEFAULT_HOURLY_CAP=25
REQUIRE_EMAIL_ACCOUNT_FOR_LAUNCH=true
